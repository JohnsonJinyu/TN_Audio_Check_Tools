      "regexConfig": {
        "matchRegex": "DT Class A1(?:\\s*\\[%\\]\\s*|\\s+)(\\d+(?:\\.\\d+)?)(?:\\s*%)?",
        "valueGroupIndex": 1,
        "valueRange": [0, 100]
      }
