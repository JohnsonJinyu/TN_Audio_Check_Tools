      "coreKeywords": ["DUT", "Delay", "SND", "EIBAND"],
      "fallbackKeywords": ["DUT", "Delay", "SND", "EIBAND"],
      "exactRowKeywords": ["DUT", "Delay", "SND"],
      "forbiddenSuffix": [],
      "requiredSuffix": [],
      "formula": {
        "targetField": "singleValue",
        "operation": "add",
        "referenceRow": {
          "coreKeywords": ["DUT", "Delay", "RCV", "EIBAND"],
          "fallbackKeywords": ["DUT", "Delay", "RCV", "EIBAND"],
          "exactRowKeywords": ["DUT", "Delay", "RCV"],
