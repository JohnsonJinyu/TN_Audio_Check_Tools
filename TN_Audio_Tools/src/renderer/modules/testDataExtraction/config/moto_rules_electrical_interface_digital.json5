    // ===== 54-56. 回声控制特性 ECC - Short =====
    {
      "itemId": 54,
      "checklistDesc": "Echo control characteristics - Short DT Class A1",
      "outputCell": "I30",
      "extractType": "regex_extract",
      "coreKeywords": ["Echo", "Control", "Chara", "short", "DT", "EIBAND"],
